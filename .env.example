# Bu dosya, projenin çalışması için gereken ortam değişkenlerini listeler.
# Gerçek değerlerle doldurup ".env.local" adıyla kopyalayın — ".env.local"
# git'e commit edilmez.
#
#   cp .env.example .env.local

# Google AdSense reklamlarını sitede aktif eder ("true" veya "false").
# AdSense hesabı onaylanana kadar "false" bırakın — bu durumda AdSlot
# bileşenleri hiçbir şey render etmez ve hiçbir AdSense script'i yüklenmez.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# AdSense yayıncı (publisher) kimliğiniz, "ca-pub-XXXXXXXXXXXXXXXX" formatında.
# AdSense hesabı onaylandıktan sonra AdSense panelinizden alabilirsiniz.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 ölçüm kimliği, "G-XXXXXXXXXX" formatında.
# Boş bırakılırsa Analytics script'i hiç yüklenmez.
NEXT_PUBLIC_GA_ID=

# Supabase proje URL'i (Project Settings → API → Project URL).
# Tanımlı değilse ürün kataloğu data/*.json dosyalarından okunmaya devam
# eder — Supabase kurmadan proje tamamen çalışır. Detaylar: README.md
# "Veritabanı (Supabase) Kurulumu" bölümü.
SUPABASE_URL=

# Supabase service_role anahtarı (Project Settings → API → service_role).
# ⚠️ anon/public key DEĞİL — bu anahtar RLS'i bypass eder, sadece
# build-time script'lerinde (scripts/*.ts) kullanılır. ASLA NEXT_PUBLIC_
# önekiyle tanımlamayın; client koduna asla sızdırılmamalıdır.
SUPABASE_SERVICE_ROLE_KEY=

# Site asistanının kullandığı Anthropic API anahtarı (console.anthropic.com
# → API Keys). Yalnızca app/api/asistan/route.ts (sunucu tarafı) tarafından
# okunur — ASLA NEXT_PUBLIC_ önekiyle tanımlamayın, client koduna sızmamalı.
# Tanımlı değilse asistan widget'ı görünür ama mesaj gönderildiğinde nazik
# bir hata mesajı gösterir; site build/çalışma açısından etkilenmez.
ANTHROPIC_API_KEY=
