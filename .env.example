# Bu dosya, projenin çalışması için gereken ortam değişkenlerini listeler.
# Gerçek değerlerle doldurup ".env.local" adıyla kopyalayın — ".env.local"
# git'e commit edilmez.
#
#   cp .env.example .env.local

# Google AdSense reklamlarını sitede aktif eder ("true" veya "false").
# AdSense hesabı onaylanana kadar "false" bırakın — bu durumda AdSlot
# bileşenleri hiçbir şey render etmez ve hiçbir AdSense script'i yüklenmez.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# AdSense yayıncı (publisher) kimliğiniz, "ca-pub-XXXXXXXXXXXXXXXX" formatında.
# AdSense hesabı onaylandıktan sonra AdSense panelinizden alabilirsiniz.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 ölçüm kimliği, "G-XXXXXXXXXX" formatında.
# Boş bırakılırsa Analytics script'i hiç yüklenmez.
NEXT_PUBLIC_GA_ID=
